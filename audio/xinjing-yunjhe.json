{"voice":"zh-TW-YunJheNeural","duration":96.312,"segs":[{"text":"無上甚深微妙法","t":[0.1,0.336,0.573,0.771,1.049,1.327,1.605]},{"text":"百千萬劫難遭遇","t":[2.006,2.194,2.381,2.57,2.707,2.874,3.271]},{"text":"我今見聞得受持","t":[3.789,3.957,4.14,4.307,4.429,4.505,4.749]},{"text":"願解如來真實義","t":[5.466,5.679,5.827,5.974,6.121,6.259,6.64]},{"text":"摩訶般若波羅蜜多心經","t":[9.088,9.347,9.576,9.759,10.003,10.155,10.308,10.46,10.582,10.795]},{"text":"觀自在菩薩","t":[13.348,13.638,13.79,13.942,14.346]},{"text":"行深般若波羅蜜多時","t":[14.888,15.132,15.375,15.543,15.726,15.868,16.011,16.153,16.305]},{"text":"照見五蘊皆空","t":[17.052,17.281,17.464,17.616,17.753,17.921]},{"text":"度一切苦厄","t":[18.546,18.729,18.874,19.019,19.331]},{"text":"舍利子","t":[19.781,20.096,20.411]},{"text":"色不異空","t":[20.848,21.119,21.389,21.66]},{"text":"空不異色","t":[22.052,22.346,22.639,22.933]},{"text":"色即是空","t":[23.348,23.638,23.775,23.958]},{"text":"空即是色","t":[24.567,24.842,24.964,25.132]},{"text":"受想行識","t":[25.878,26.1,26.321,26.755]},{"text":"亦復如是","t":[27.311,27.494,27.662,28.058]},{"text":"舍利子","t":[28.561,28.876,29.191]},{"text":"是諸法空相","t":[29.613,29.872,30.071,30.269,30.673]},{"text":"不生不滅","t":[31.199,31.356,31.514,31.671]},{"text":"不垢不淨","t":[32.372,32.548,32.723,32.845]},{"text":"不增不減","t":[33.531,33.653,33.821,33.943]},{"text":"是故空中無色","t":[34.644,34.903,35.04,35.208,35.375,35.543]},{"text":"無受想行識","t":[36.305,36.488,36.664,36.839,37.311]},{"text":"無眼耳鼻舌身意","t":[37.921,38.094,38.267,38.439,38.577,38.714,39.118]},{"text":"無色聲香味觸法","t":[39.659,39.872,40.055,40.238,40.391,40.543,40.924]},{"text":"無眼界","t":[41.427,41.61,41.824]},{"text":"乃至無意識界","t":[42.555,42.761,42.967,43.119,43.272,43.424]},{"text":"無無明","t":[44.125,44.43,44.735]},{"text":"亦無無明盡","t":[45.325,45.539,45.684,45.828,46.027]},{"text":"乃至無老死","t":[46.774,46.972,47.17,47.307,47.719]},{"text":"亦無老死盡","t":[48.267,48.45,48.557,48.872,49.187]},{"text":"無苦集滅道","t":[49.639,49.838,50.005,50.295,50.585]},{"text":"無智亦無得","t":[50.981,51.156,51.332,51.453,51.774]},{"text":"以無所得故","t":[