{"voice":"zh-TW-HsiaoYuNeural","duration":121.632,"segs":[{"text":"無上甚深微妙法","t":[0.111,0.332,0.568,0.858,1.136,1.414,1.693]},{"text":"百千萬劫難遭遇","t":[2.413,2.672,2.931,3.297,3.663,3.907,4.204]},{"text":"我今見聞得受持","t":[4.913,5.294,5.584,5.904,6.178,6.315,6.635]},{"text":"願解如來真實義","t":[7.428,7.702,7.997,8.292,8.693,8.907,9.227]},{"text":"摩訶般若波羅蜜多心經","t":[11.787,12.107,12.366,12.824,13.128,13.388,13.647,14.043,14.333,14.622]},{"text":"觀自在菩薩","t":[17.271,17.454,17.705,18.064,18.338]},{"text":"行深般若波羅蜜多時","t":[18.948,19.245,19.619,19.969,20.244,20.467,20.691,21.021,21.28]},{"text":"照見五蘊皆空","t":[22.042,22.347,22.698,23.018,23.292,23.673]},{"text":"度一切苦厄","t":[24.405,24.649,24.87,25.167,25.434]},{"text":"舍利子","t":[26.006,26.295,26.585]},{"text":"色不異空","t":[27.317,27.583,27.85,28.117]},{"text":"空不異色","t":[28.75,29.013,29.276,29.538]},{"text":"色即是空","t":[30.152,30.487,30.823,31.082]},{"text":"空即是色","t":[31.661,31.951,32.286,32.545]},{"text":"受想行識","t":[33.262,33.498,33.811,34.131]},{"text":"亦復如是","t":[34.893,35.076,35.381,35.655]},{"text":"舍利子","t":[36.295,36.575,36.854]},{"text":"是諸法空相","t":[37.5,37.774,37.987,38.338,38.605]},{"text":"不生不滅","t":[39.268,39.507,39.746,40.03]},{"text":"不垢不淨","t":[40.64,40.861,41.173,41.356]},{"text":"不增不減","t":[42.042,42.256,42.515,42.728]},{"text":"是故空中無色","t":[43.46,43.75,44.009,44.253,44.497,44.862]},{"text":"無受想行識","t":[45.457,45.823,46.059,46.372,46.699]},{"text":"無眼耳鼻舌身意","t":[47.393,47.632,47.871,48.262,48.49,48.795,49.062]},{"text":"無色聲香味觸法","t":[49.725,50.061,50.32,50.579,50.853,51.25,51.509]},{"text":"無眼界","t":[52.119,52.454,52.698]},{"text":"乃至無意識界","t":[53.384,53.681,54.054,54.293,54.532,54.832]},{"text":"無無明","t":[55.487,55.757,56.026]},{"text":"亦無無明盡","t":[56.768,56.981,57.225,57.484,57.774]},{"text":"乃至無老死","t":[58.429,58.727,59.1,59.39,59.679]},{"text":"亦無老死盡","t":[60.396,60.609,60.899,61.179,61.458]},{"text":"無苦集滅道","t":[62.149,62.469,62.774,63.023,63.272]},{"text":"無智亦無得","t":[63.872,64.154,64.451,64.695,64.931]},{"text":"以無所得故",