{"voice":"zh-TW-HsiaoChenNeural","duration":105.24,"segs":[{"text":"無上甚深微妙法","t":[0.111,0.324,0.568,0.797,1.071,1.346,1.62]},{"text":"百千萬劫難遭遇","t":[2.138,2.347,2.555,2.824,3.007,3.251,3.548]},{"text":"我今見聞得受持","t":[4.212,4.394,4.608,4.791,5.004,5.157,5.446]},{"text":"願解如來真實義","t":[6.254,6.468,6.656,6.844,7.077,7.291,7.588]},{"text":"摩訶般若波羅蜜多心經","t":[10.059,10.333,10.562,10.791,11.019,11.202,11.385,11.614,11.797,12.071]},{"text":"觀自在菩薩","t":[14.463,14.737,14.92,15.149,15.461]},{"text":"行深般若波羅蜜多時","t":[16.079,16.323,16.643,16.841,17.07,17.232,17.395,17.618,17.832]},{"text":"照見五蘊皆空","t":[18.686,18.899,19.097,19.265,19.493,19.753]},{"text":"度一切苦厄","t":[20.515,20.667,20.82,21.033,21.33]},{"text":"舍利子","t":[21.948,22.237,22.527]},{"text":"色不異空","t":[23.183,23.434,23.686,23.937]},{"text":"空不異色","t":[24.524,24.764,25.004,25.244]},{"text":"色即是空","t":[25.774,26.079,26.277,26.567]},{"text":"空即是色","t":[27.253,27.497,27.679,27.908]},{"text":"受想行識","t":[28.609,28.846,29.097,29.44]},{"text":"亦復如是","t":[30.149,30.301,30.515,30.82]},{"text":"舍利子","t":[31.46,31.75,32.039]},{"text":"是諸法空相","t":[32.634,32.878,33.099,33.381,33.678]},{"text":"不生不滅","t":[34.28,34.463,34.646,34.844]},{"text":"不垢不淨","t":[35.53,35.698,35.881,36.109]},{"text":"不增不減","t":[36.75,36.948,37.161,37.359]},{"text":"是故空中無色","t":[38.061,38.335,38.518,38.711,38.904,39.112]},{"text":"無受想行識","t":[39.875,40.027,40.248,40.5,40.835]},{"text":"無眼耳鼻舌身意","t":[41.506,41.689,41.872,42.085,42.275,42.481,42.794]},{"text":"無色聲香味觸法","t":[43.442,43.609,43.807,44.067,44.25,44.463,44.806]},{"text":"無眼界","t":[45.423,45.621,45.881]},{"text":"乃至無意識界","t":[46.597,46.772,47.024,47.192,47.359,47.603]},{"text":"無無明","t":[48.35,48.564,48.777]},{"text":"亦無無明盡","t":[49.383,49.596,49.748,49.901,50.175]},{"text":"乃至無老死","t":[50.861,51.044,51.303,51.517,51.844]},{"text":"亦無老死盡","t":[52.508,52.66,52.873,53.117,53.361]},{"text":"無苦集滅道","t":[53.986,54.184,54.443,54.703,54.962]},{"text":"無智亦無得","t":[55.572,55.716,55.876,56.075,56.372]},{"text":"以無所得故",